{% extends 'DiagnosticTool/base.html' %}

{% block title %}
    {{ scenario.name }}
{% endblock %}

{% block header %}
    <a href="{% url 'home' %}" class="btn btn-secondary">
        ← Retour à l'accueil
    </a>
{% endblock %}

{% block content %}
<div class="container mt-4">
    {% if diagnostic_launched %}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            🛠️ Le diagnostic a bien été lancé. Veuillez patienter quelques instants, puis actualisez la page pour voir le résultat.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row g-4">
        <!-- Bloc scénario -->
        <div class="col-md-6">
            <section class="card h-100 p-4 shadow-sm" style="margin-bottom: 5rem;">
                <h2 class="card-title">🧪 Scénario : {{ scenario.name }}</h2>
                <p class="text-muted">{{ scenario }}</p>
                <p>{{ scenario.description }}</p>

                <form method="post">
                    {% csrf_token %}
                    <button type="submit" class="btn btn-success mt-3">
                        Lancer le diagnostic
                    </button>
                </form>
            </section>
        </div>

        <!-- Bloc analyse -->
        <div class="col-md-6">
            <section class="card h-100 p-4 shadow-sm">
                <h2 class="card-title">🔍 Analyse</h2>
                <div class="analysis-content mt-3">
                    {% if diagnostic_result %}
                        <p>
                            <strong>Résultat :</strong>
                            <pre class="bg-light p-3 border rounded mt-2">{{ diagnostic_result }}</pre>
                        </p>
                    {% else %}
                        <p>
                            <strong class="text-danger">Pour votre information :</strong>
                            Le résultat du diagnostic sera affiché ici après que vous aurez cliqué sur <i>Lancer le diagnostic</i>
                        </p>
                    {% endif %}

                    <form method="post" action="">
                        {% csrf_token %}
                        <button class="btn btn-outline-primary mt-3">
                            📄 Exporter le rapport en PDF
                        </button>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>
{% endblock %}
