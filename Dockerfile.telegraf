FROM python:3.12.7-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.local/bin:$PATH"

# Install system dependencies including openvpn and telegraf
RUN apt-get update && \
    apt-get install -y --no-install-recommends gnupg apt-transport-https curl && \
    curl -sL https://repos.influxdata.com/influxdata-archive.key | gpg --dearmor -o /usr/share/keyrings/influxdata-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/influxdata-archive-keyring.gpg] https://repos.influxdata.com/debian stable main" > /etc/apt/sources.list.d/influxdata.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends openvpn telegraf && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY DiagnosticTool/fixtures /app/DiagnosticTool/fixtures
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

COPY . .

# Copy telegraf configuration
COPY DiagnosticTool/core/telegraf/telegraf.conf /etc/telegraf/telegraf.conf
COPY DiagnosticTool/core/telegraf/telegraf.d /etc/telegraf/telegraf.d

COPY telegraf_entrypoint.sh /telegraf_entrypoint.sh
RUN chmod +x /telegraf_entrypoint.sh

CMD ["/telegraf_entrypoint.sh"]
